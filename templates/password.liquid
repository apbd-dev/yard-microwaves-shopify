{% layout 'password' %}
{%- comment -%}
  #25: branded coming-soon password page. Replaces auto-generated templates/password.json.
  Password entry dialog is provided by layout/password.liquid (Dawn footer, "Enter using password").
{%- endcomment -%}
<section class="ym-section ym-paper-bg ym-password">
  <div class="ym-container ym-password__container">
    <img
      src="{{ 'ym-logo.svg' | asset_url }}"
      alt="{{ shop.name | escape }}"
      class="ym-password__logo"
      width="240"
      height="124"
    >

    <h1 class="ym-script-heading ym-password__heading">
      {%- if shop.password_message != blank -%}
        {{ shop.password_message }}
      {%- else -%}
        Coming soon
      {%- endif -%}
    </h1>

    <p class="ym-password__body">We're firing up the smoker. Drop your email to know the second we open.</p>

    {%- form 'customer', class: 'ym-password__signup' -%}
      <input type="hidden" name="contact[tags]" value="prospect,coming-soon">
      <input type="hidden" name="contact[accepts_marketing]" value="true">
      <label for="ym-notify-email" class="visually-hidden">Email address</label>
      <div class="ym-password__signup-row">
        <input
          id="ym-notify-email"
          type="email"
          name="contact[email]"
          placeholder="you@example.com"
          autocomplete="email"
          required
          class="ym-password__input"
        >
        <button type="submit" class="ym-btn-red ym-password__submit">Notify me</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="ym-password__notice">Thanks — we'll let you know.</p>
      {%- elsif form.errors -%}
        <p class="ym-password__notice ym-password__notice--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
