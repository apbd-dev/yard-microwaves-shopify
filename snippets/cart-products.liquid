{%- doc -%}
  YM-themed cart line items. Replaces Dawn's table-based markup with a flat
  list so the design matches the Figma drawer without fighting Dawn's CSS.

  Critical bits preserved for Dawn's cart-items-component to keep working:
    • `ref="cartItemCount"` + `ref="cartItemRows[]"` (morphSection uses these)
    • `data-key="{{ item.key }}"` and `data-parent-key=...` on each row
    • `cart-items__error` + `ref="cartItemError-X"` for inline error rendering
    • `quantity-selector` snippet (renders the +/− component)
    • `on:click="/onLineItemRemove/N"` for the remove button
    • The wrapping `<form action="{{ routes.cart_url }}" id="cart-form" method="post">`
{%- enddoc -%}

<script
  src="{{ 'component-cart-items.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div class="cart-items__wrapper ym-cart-items-wrapper" {{ block.shopify_attributes }}>
  {%- if cart.empty? -%}
    {%- if shop.customer_accounts_enabled and customer == null -%}
      <p class="ym-cart-empty-login">{{ 'actions.log_in_html' | t: link: routes.account_login_url }}</p>
    {%- endif -%}

    <a class="ym-btn-red ym-cart-empty-cta" href="/#shop">
      {{ 'actions.continue_shopping' | t }}
    </a>
  {%- else -%}
    <span class="visually-hidden" ref="cartItemCount" aria-hidden="true">{{- cart.item_count -}}</span>

    <form action="{{ routes.cart_url }}" class="cart-form" id="cart-form" method="post">
      <ul class="ym-cart-items" role="list">
        {%- for item in cart.items -%}
          {%- assign can_remove = item.instructions.can_remove | default: true, allow_false: true -%}
          {%- assign can_update_quantity = item.instructions.can_update_quantity | default: true, allow_false: true -%}
          <li
            class="ym-cart-item{% if item.parent_relationship.parent != null %} ym-cart-item--nested{% endif %}"
            ref="cartItemRows[]"
            data-parent-key="{{ item.parent_relationship.parent.key }}"
            data-key="{{ item.key }}"
          >
            <div class="ym-cart-item__media">
              {%- if can_remove -%}
                <button
                  type="button"
                  class="ym-cart-item__remove"
                  on:click="/onLineItemRemove/{{ item.index | plus: 1 }}"
                  aria-label="{{ 'accessibility.remove_item' | t: title: item.title | escape }}"
                >
                  <span aria-hidden="true">×</span>
                </button>
              {%- endif -%}
              <a href="{{ item.url }}" class="ym-cart-item__thumb-link" tabindex="-1">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 280 | image_tag:
                      class: 'ym-cart-item__thumb',
                      loading: 'lazy',
                      alt: item.title }}
                {%- endif -%}
              </a>
            </div>

            <div class="ym-cart-item__body">
              <div class="ym-cart-item__title-row">
                <a href="{{ item.url }}" class="ym-cart-item__title">
                  {%- if item.parent_relationship.parent != null -%}
                    {{- item.product.title -}}
                  {%- else -%}
                    {{- item.product.title -}}
                  {%- endif -%}
                </a>
                <span class="ym-cart-item__leader" aria-hidden="true"></span>
                <span class="ym-cart-item__price">{{ item.final_line_price | money }}</span>
              </div>

              <div class="ym-cart-item__meta-row">
                <div class="ym-cart-item__meta">
                  {%- if item.product.has_only_default_variant == false and item.item_components.size == 0 -%}
                    <ul class="ym-cart-item__variants" aria-label="Variant">
                      {%- for option in item.options_with_values -%}
                        <li>{{ option.value }}</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  {%- if item.item_components.size != 0 -%}
                    <ul class="ym-cart-item__variants ym-cart-item__bundle" aria-label="Bundle contents">
                      {%- for component in item.item_components -%}
                        <li>{{ component.title }}{% if component.quantity > 1 %} × {{ component.quantity }}{% endif %}</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  {%- if item.line_level_discount_allocations.size > 0 -%}
                    <ul class="ym-cart-item__discounts">
                      {%- for discount in item.line_level_discount_allocations -%}
                        <li>{{ discount.discount_application.title | escape }}</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="ym-cart-item__qty-wrap">
                  {%- render 'quantity-selector',
                    product: item.product,
                    in_cart_quantity: item.quantity,
                    line_index: item.index,
                    min: 0,
                    class: 'ym-cart-item__qty',
                    can_update_quantity: can_update_quantity
                  -%}
                </div>
              </div>

              <div
                class="cart-items__error ym-cart-item__error hidden"
                ref="cartItemErrorContainer-{{ item.index | plus: 1 }}"
                role="alert"
              >
                <span class="svg-wrapper">{{ 'icon-error.svg' | inline_asset_content }}</span>
                <small ref="cartItemError-{{ item.index | plus: 1 }}"></small>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </form>
  {%- endif -%}
</div>
