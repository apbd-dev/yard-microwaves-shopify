{%- doc -%}
  Renders the cart icon (#39: YM smoker). Smoke puffs above the chimney
  signal a non-empty cart; no numeric bubble.
{%- enddoc -%}
<cart-icon
  class="
    header-actions__cart-icon
    ym-cart-smoker
    {% unless cart == empty %} header-actions__cart-icon--has-cart{% endunless %}
  "
  data-testid="cart-icon"
>
  <span class="ym-cart-smoker__smoke" aria-hidden="true">
    <span class="ym-cart-smoker__puff"></span>
    <span class="ym-cart-smoker__puff"></span>
    <span class="ym-cart-smoker__puff"></span>
  </span>

  <span
    class="svg-wrapper ym-cart-smoker__icon"
    aria-hidden="true"
  >
    {{ 'ym-icon-smoker.svg' | inline_asset_content }}
  </span>

  {%- comment -%}
    #39: count bubble intentionally omitted — smoke = cart has items, no smoke = empty.
    Item count is still announced to screen readers via the parent button's aria-label
    in snippets/header-actions.liquid.
  {%- endcomment -%}
</cart-icon>

