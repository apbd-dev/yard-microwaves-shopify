<section class="ym-section ym-section--dark ym-footer-cta" id="ym-footer-cta">
  {%- comment -%} Torn-paper edge (#44/#16) — same asset as the hero so the language stays consistent. Flipped so paper tears away upward to reveal the dark footer. {%- endcomment -%}
  <div class="ym-footer-cta__torn-edge" aria-hidden="true">
    <img src="{{ 'ym-torn-edge-merged.png' | asset_url }}" alt="" role="presentation" loading="lazy" width="1920" height="196">
  </div>
  <div class="ym-container">
    <h2 class="ym-footer-cta__heading">
      {{ section.settings.heading | default: 'HOT LINKS' }}
    </h2>

    {%- comment -%} Horizontal sausage chain (#48). Single chain PNG + three absolutely-positioned links, one per sausage, each carrying its platform icon. {%- endcomment -%}
    <div class="ym-footer-cta__hot-links">
      <img
        class="ym-footer-cta__hot-links-chain"
        src="{{ 'ym-hot-links-chain.png' | asset_url }}"
        alt=""
        role="presentation"
        loading="lazy"
        width="1192"
        height="89"
      >
      {%- for block in section.blocks -%}
        {%- if block.type == 'social_link' -%}
          {%- assign platform_slug = block.settings.platform | downcase -%}
          <a
            href="{{ block.settings.url }}"
            class="ym-footer-cta__hot-link ym-footer-cta__hot-link--{{ platform_slug }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ block.settings.platform }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {%- case block.settings.platform -%}
                {%- when 'Instagram' -%}
                  <img src="{{ 'ym-icon-instagram.png' | asset_url }}" alt="" loading="lazy" width="285" height="49">
                {%- when 'Facebook' -%}
                  <img src="{{ 'ym-icon-facebook.png' | asset_url }}" alt="" loading="lazy" width="256" height="49">
                {%- when 'TikTok' -%}
                  <img src="{{ 'ym-icon-tiktok.png' | asset_url }}" alt="" loading="lazy" width="175" height="49">
              {%- endcase -%}
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "YM - Footer CTA",
  "tag": "section",
  "class": "ym-footer-cta-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HOT LINKS"
    }
  ],
  "blocks": [
    {
      "type": "social_link",
      "name": "Social Link",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "options": [
            { "value": "Instagram", "label": "Instagram" },
            { "value": "Facebook", "label": "Facebook" },
            { "value": "TikTok", "label": "TikTok" }
          ],
          "default": "Instagram"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Profile URL"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YM - Footer CTA",
      "blocks": [
        { "type": "social_link", "settings": { "platform": "Instagram" } },
        { "type": "social_link", "settings": { "platform": "Facebook" } },
        { "type": "social_link", "settings": { "platform": "TikTok" } }
      ]
    }
  ]
}
{% endschema %}
