<section class="ym-section ym-paper-bg ym-quality-banner" id="ym-quality-banner">
  {%- comment -%} Sparkle decorations {%- endcomment -%}
  <div class="ym-deco" style="top: -10px; right: 8%; width: 120px;">
    <img src="{{ 'ym-sparkle-1.png' | asset_url }}" alt="" role="presentation" loading="lazy" width="240" height="300">
  </div>
  <div class="ym-deco" style="bottom: -20px; left: 5%; width: 80px;">
    <img src="{{ 'ym-pellets-sm.png' | asset_url }}" alt="" role="presentation" loading="lazy" width="160" height="160">
  </div>

  {%- if section.settings.sparkles_overlay != blank -%}
    <div class="ym-deco" style="inset: 0; width: 100%; height: 100%; opacity: 0.3;">
      {{ section.settings.sparkles_overlay | image_url: width: 1440 | image_tag: loading: 'lazy', style: 'width:100%;height:100%;object-fit:cover;' }}
    </div>
  {%- endif -%}

  <div class="ym-container">
    <p class="ym-quality-banner__text">
      {{ section.settings.text | default: 'QUALITY BEYOND COMPARE. PRESHRUNK FOR PERFECTION. JUST LIKE YOUR BRISKET, OUR SHIRTS EXCEED EXPECTATIONS. GUARANTEED.' }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "YM - Quality Banner",
  "tag": "section",
  "class": "ym-quality-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Banner text",
      "default": "QUALITY BEYOND COMPARE. PRESHRUNK FOR PERFECTION. JUST LIKE YOUR BRISKET, OUR SHIRTS EXCEED EXPECTATIONS. GUARANTEED."
    },
    {
      "type": "image_picker",
      "id": "sparkles_overlay",
      "label": "Sparkles overlay image"
    }
  ],
  "presets": [
    {
      "name": "YM - Quality Banner"
    }
  ]
}
{% endschema %}
