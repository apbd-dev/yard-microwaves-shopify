{%- comment -%}
  YM - Footer: the full store footer, in the site's own language.
  Torn edge -> tilted ticker band -> paper signup card + big menus ->
  HOT LINKS sausage chain -> butcher-paper jumbo wordmark with the
  mascot peeking over it (smoke, sparkles, pellets) -> policy bar.
  Styles: ym-custom.css "YM FOOTER". Motion is off under
  prefers-reduced-motion.
{%- endcomment -%}

{%- liquid
  assign menu_blocks = section.blocks | where: 'type', 'menu'
  assign social_blocks = section.blocks | where: 'type', 'social_link'
  assign form_id = 'ym-footer-signup-' | append: section.id
  assign ticker_items = section.settings.ticker | split: '|'
-%}

<div class="ym-footer" id="ym-footer">
  <div class="ym-footer__torn-edge" aria-hidden="true">
    <img
      src="{{ 'ym-torn-edge-merged.png' | asset_url }}"
      alt=""
      role="presentation"
      loading="lazy"
      width="1920"
      height="196"
    >
  </div>

  {%- if section.settings.ticker != blank -%}
    <div class="ym-footer__ticker" aria-hidden="true">
      <div class="ym-footer__ticker-track">
        {%- for pass in (1..2) -%}
          <div class="ym-footer__ticker-run">
            {%- for rep in (1..2) -%}
              {%- for item in ticker_items -%}
                <span class="ym-footer__ticker-item">{{ item | strip | escape }}</span>
                <span class="ym-footer__ticker-star">&#10022;</span>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="ym-container ym-footer__inner">
    <div class="ym-footer__top">
      <div class="ym-footer__card">
        <span class="ym-footer__tape" aria-hidden="true"></span>
        {%- if section.settings.sticker_text != blank -%}
          <div class="ym-footer__sticker" aria-hidden="true">
            <img src="{{ 'ym-cart-starburst.png' | asset_url }}" alt="" loading="lazy" width="242" height="242">
            <span>{{ section.settings.sticker_text | escape }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.signup_kicker != blank -%}
          <p class="ym-footer__kicker">{{ section.settings.signup_kicker | escape }}</p>
        {%- endif -%}
        <h2 class="ym-footer__card-heading">{{ section.settings.signup_heading | escape }}</h2>
        {%- if section.settings.signup_text != blank -%}
          <div class="ym-footer__card-text">{{ section.settings.signup_text }}</div>
        {%- endif -%}

        {%- form 'customer', id: form_id, class: 'ym-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="ym-footer__form-msg" role="status" tabindex="-1" autofocus>
              {{ section.settings.signup_success | escape }}
            </p>
          {%- else -%}
            <div class="ym-footer__field">
              <label class="visually-hidden" for="{{ form_id }}-email">Email address</label>
              <input
                id="{{ form_id }}-email"
                class="ym-footer__input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="your@email.com"
                required
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="{{ form_id }}-error"
                {% endif %}
              >
              <button type="submit" class="ym-footer__submit">
                {{- section.settings.signup_button | default: 'Plug in' | escape -}}
                <span aria-hidden="true">&rarr;</span>
              </button>
            </div>
            {%- if form.errors -%}
              <p class="ym-footer__form-msg ym-footer__form-msg--error" id="{{ form_id }}-error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="ym-footer__menus">
        {%- for block in menu_blocks -%}
          {%- assign menu = linklists[block.settings.menu] -%}
          <nav class="ym-footer__menu" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="ym-footer__menu-heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if menu.links.size > 0 -%}
              <ul class="ym-footer__links" role="list">
                {%- for link in menu.links -%}
                  <li>
                    <a
                      href="{{ link.url }}"
                      class="ym-footer__link"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- link.title -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </nav>
        {%- endfor -%}

        {%- if section.settings.brand_text != blank -%}
          <p class="ym-footer__scrawl">{{ section.settings.brand_text | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if social_blocks.size > 0 -%}
      <div class="ym-footer__hot">
        <h2 class="ym-footer__hot-heading">
          {{ section.settings.social_heading | escape }}
          <svg class="ym-footer__hot-arrow" viewBox="0 0 80 60" aria-hidden="true" focusable="false">
            <path d="M6 8 C 30 4, 52 18, 60 46" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
            <path d="M46 40 L 61 50 L 68 32" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </h2>
        <div class="ym-footer-cta__hot-links ym-footer__chain">
          <img
            class="ym-footer-cta__hot-links-chain"
            src="{{ 'ym-hot-links-chain.png' | asset_url }}"
            alt=""
            role="presentation"
            loading="lazy"
            width="1192"
            height="89"
          >
          {%- for block in social_blocks -%}
            {%- if block.settings.url != blank -%}
              {%- assign platform_slug = block.settings.platform | downcase -%}
              <a
                href="{{ block.settings.url }}"
                class="ym-footer-cta__hot-link ym-footer-cta__hot-link--{{ platform_slug }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="{{ block.settings.platform }} (opens in a new tab)"
                {{ block.shopify_attributes }}
              >
                {%- case block.settings.platform -%}
                  {%- when 'Instagram' -%}
                    <img src="{{ 'ym-icon-instagram.png' | asset_url }}" alt="" loading="lazy" width="285" height="49">
                  {%- when 'Facebook' -%}
                    <img src="{{ 'ym-icon-facebook.png' | asset_url }}" alt="" loading="lazy" width="256" height="49">
                  {%- when 'TikTok' -%}
                    <img src="{{ 'ym-icon-tiktok.png' | asset_url }}" alt="" loading="lazy" width="175" height="49">
                {%- endcase -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_wordmark -%}
      <div class="ym-footer__wordmark" aria-hidden="true">
        <img class="ym-footer__pellets ym-footer__pellets--l" src="{{ 'ym-pellets-scatter.png' | asset_url }}" alt="" loading="lazy" width="362" height="636">
        <img class="ym-footer__pellets ym-footer__pellets--r" src="{{ 'ym-pellets-scatter.png' | asset_url }}" alt="" loading="lazy" width="362" height="636">
        <img class="ym-footer__sparkle ym-footer__sparkle--1" src="{{ 'ym-sparkle-1.png' | asset_url }}" alt="" loading="lazy" width="322" height="424">
        <img class="ym-footer__sparkle ym-footer__sparkle--2" src="{{ 'ym-sparkle-1.png' | asset_url }}" alt="" loading="lazy" width="322" height="424">
        <img class="ym-footer__sparkle ym-footer__sparkle--3" src="{{ 'ym-sparkle-1.png' | asset_url }}" alt="" loading="lazy" width="322" height="424">

        <div class="ym-footer__peek">
          <span class="ym-footer__smoke ym-footer__smoke--1"><img src="{{ 'ym-icon-smoke.png' | asset_url }}" alt="" loading="lazy" width="83" height="78"></span>
          <span class="ym-footer__smoke ym-footer__smoke--2"><img src="{{ 'ym-icon-smoke.png' | asset_url }}" alt="" loading="lazy" width="83" height="78"></span>
          <span class="ym-footer__smoke ym-footer__smoke--3"><img src="{{ 'ym-icon-smoke.png' | asset_url }}" alt="" loading="lazy" width="83" height="78"></span>
          <img class="ym-footer__mascot" src="{{ 'ym-mascot.png' | asset_url }}" alt="" loading="lazy" width="250" height="180">
        </div>

        {%- comment -%} textLength fits the word to the container at every width; the butcher-paper print fills the letters. {%- endcomment -%}
        {%- liquid
          assign wm = section.settings.wordmark_text | default: shop.name | upcase | escape
          assign wm_words = wm | split: ' '
          assign wm_line1 = wm_words.first
          assign wm_line2 = wm | remove_first: wm_line1 | strip
          assign paper_id = 'ym-footer-paper-' | append: section.id
        -%}
        <svg width="0" height="0" class="ym-footer__defs" focusable="false">
          <defs>
            <pattern id="{{ paper_id }}" patternUnits="userSpaceOnUse" width="560" height="560">
              <image href="{{ 'ym-butcher-paper.png' | asset_url }}" x="-230" y="-230" width="1020" height="992" preserveAspectRatio="xMidYMid slice"/>
            </pattern>
          </defs>
        </svg>
        {%- comment -%} textLength fits each line to the container at every width; the butcher-paper print fills the letters. Desktop: one line. Phones: two. {%- endcomment -%}
        <svg class="ym-footer__wordmark-svg ym-footer__wordmark-svg--wide" viewBox="0 0 1000 124" preserveAspectRatio="xMidYMid meet" focusable="false">
          <text class="ym-footer__wordmark-shadow" x="6" y="114" textLength="994" lengthAdjust="spacingAndGlyphs">{{ wm }}</text>
          <text x="0" y="108" textLength="994" lengthAdjust="spacingAndGlyphs" fill="url(#{{ paper_id }})">{{ wm }}</text>
        </svg>
        <svg class="ym-footer__wordmark-svg ym-footer__wordmark-svg--stack" viewBox="0 0 1000 {% if wm_line2 != blank %}520{% else %}290{% endif %}" preserveAspectRatio="xMidYMid meet" focusable="false">
          <text class="ym-footer__wordmark-shadow ym-footer__wordmark-big" x="12" y="264" textLength="988" lengthAdjust="spacingAndGlyphs">{{ wm_line1 }}</text>
          <text class="ym-footer__wordmark-big" x="0" y="252" textLength="988" lengthAdjust="spacingAndGlyphs" fill="url(#{{ paper_id }})">{{ wm_line1 }}</text>
          {%- if wm_line2 != blank -%}
            <text class="ym-footer__wordmark-shadow ym-footer__wordmark-mid" x="10" y="498" textLength="990" lengthAdjust="spacingAndGlyphs">{{ wm_line2 }}</text>
            <text class="ym-footer__wordmark-mid" x="0" y="488" textLength="990" lengthAdjust="spacingAndGlyphs" fill="url(#{{ paper_id }})">{{ wm_line2 }}</text>
          {%- endif -%}
        </svg>
      </div>
    {%- endif -%}

    <div class="ym-footer__bottom">
      <p class="ym-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name | link_to: routes.root_url }}.
        <span class="ym-footer__fine">{{ section.settings.fine_print | escape }}</span>
      </p>
      {%- if shop.policies.size > 0 -%}
        <ul class="ym-footer__policies" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}" class="ym-footer__policy">{{ policy.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "YM - Footer",
  "tag": "footer",
  "class": "ym-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Ticker"
    },
    {
      "type": "text",
      "id": "ticker",
      "label": "Ticker lines",
      "info": "Separate lines with |. Leave blank to hide the ticker.",
      "default": "Low and slow|Plug it in|Not a grill|Hot links inside|Smoke signals received"
    },
    {
      "type": "header",
      "content": "Email signup card"
    },
    {
      "type": "text",
      "id": "signup_kicker",
      "label": "Kicker",
      "default": "The newsletter"
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Heading",
      "default": "Get plugged in"
    },
    {
      "type": "richtext",
      "id": "signup_text",
      "label": "Text",
      "default": "<p>Drops, deals and hot links, straight to your inbox. Extension cords not included.</p>"
    },
    {
      "type": "text",
      "id": "signup_button",
      "label": "Button label",
      "default": "Plug in"
    },
    {
      "type": "text",
      "id": "signup_success",
      "label": "Success message",
      "default": "You're plugged in. Watch your inbox."
    },
    {
      "type": "text",
      "id": "sticker_text",
      "label": "Starburst sticker",
      "default": "No spam. Just smoke."
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Marker scrawl",
      "default": "We do not make grills. Please stop asking."
    },
    {
      "type": "header",
      "content": "Hot links"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Heading",
      "default": "Hot links"
    },
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show jumbo wordmark",
      "default": true
    },
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Wordmark text",
      "default": "Yard Microwaves"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "Smoked, not microwaved."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "main-menu"
        }
      ]
    },
    {
      "type": "social_link",
      "name": "Hot link",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "options": [
            { "value": "Instagram", "label": "Instagram" },
            { "value": "Facebook", "label": "Facebook" },
            { "value": "TikTok", "label": "TikTok" }
          ],
          "default": "Instagram"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Profile URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YM - Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop", "menu": "main-menu" } },
        { "type": "menu", "settings": { "heading": "Help", "menu": "footer" } },
        { "type": "social_link", "settings": { "platform": "Instagram" } },
        { "type": "social_link", "settings": { "platform": "Facebook" } },
        { "type": "social_link", "settings": { "platform": "TikTok" } }
      ]
    }
  ]
}
{% endschema %}
